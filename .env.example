# Atlas configuration template.
#
# Copy to `.env` and fill in as needed. EVERYTHING here is optional: with no
# .env at all, Atlas runs zero-config (SQLite + in-process queue + no LLM, which
# degrades the agent to deterministic planning and numbers-only narration).
# All variables use the ATLAS_ prefix and map 1:1 to atlas.platform.runtime.Settings.

# --- Persistence -------------------------------------------------------------
# Default is local SQLite. For the full stack use Postgres:
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_DATABASE_URL=sqlite:///var/atlas.db

# --- Queue -------------------------------------------------------------------
# Empty = in-process queue (runs jobs synchronously; fine for dev/tests).
# Set to use the ARQ + Redis worker:
# ATLAS_REDIS_URL=redis://localhost:6379
ATLAS_REDIS_URL=

# --- Storage -----------------------------------------------------------------
# Where snapshots, artifacts and the FRED cache live (gitignored).
ATLAS_DATA_DIR=var/data

# Create tables directly on startup (SQLite dev only). Postgres uses Alembic.
ATLAS_AUTO_CREATE_SCHEMA=true

# Analysis job retry budget (exponential backoff).
ATLAS_JOB_MAX_TRIES=3

# Enables browser bootstrap with synthetic data and a browser-session API key.
# Keep false outside an explicitly local demonstration environment.
ATLAS_DEMO_MODE=false

# --- Agent LLM ---------------------------------------------------------------
# Empty key -> NullLLMClient -> the agent still works, degraded: deterministic
# planning + fully-cited numbers-only narration. Set a key for LLM planning/prose.
# ATLAS_ANTHROPIC_API_KEY=sk-ant-...
ATLAS_ANTHROPIC_API_KEY=
ATLAS_LLM_MODEL=claude-haiku-4-5-20251001
