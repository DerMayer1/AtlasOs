# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Tavily ────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # server-side only, never expose to frontend
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... # safe for frontend

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (PDF export storage) ────────────────────
R2_BUCKET_URL=                        # optional in V1

# ── Pipeline ──────────────────────────────────────────────
PIPELINE_TIMEOUT_S=90
LOG_LEVEL=info                        # debug | info | warning
